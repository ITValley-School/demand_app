<!-- Wappler include head-page="layouts/dashboard_aluno" fontawesome_5="cdn" bootstrap5="custom" is="dmx-app" id="certificados" appConnect="local" components="{dmxBootstrap5Navigation:{},dmxDataTraversal:{}}" -->
<script is="dmx-flow" id="flow_certificados" type="text/dmx-flow">{
  serverConnect: {
    name: "sc_gerar_certificado",
    outputType: "object",
    url: "/api/certificados/gerar_certificado",
    site: "task_demander",
    params: {
      tarefa: "{{gerar_certificados_detail.data.nome_tarefa}}",
      horas: "{{gerar_certificados_detail.data.estimativa_horas_tarefas}}",
      programa: "{{gerar_certificados_detail.data.programa}}",
      tarefa_id: "{{gerar_certificados_detail.data.tarefa_id}}"
    }
  }
}</script>
<dmx-data-detail id="gerar_certificados_detail" dmx-bind:data="sc_listar_concluidas.data.query_listar_my_tasks.data" key="id"></dmx-data-detail>
<meta name="ac:route" content="/certificados">

<main>
    <dmx-api id="api_certificado" url="http://localhost:8000/gerar_certificado" method="post" data-type="json" headers="" noload>
    </dmx-api>


    <!-- Modal de sucesso com link para o certificado -->
    <div class="modal fade" id="modal_certificado_gerado" is="dmx-bs5-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h5 class="modal-title">✅ Certificado Gerado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p>Seu certificado foi gerado com sucesso.</p>
                    <a dmx-bind:href="api_certificado.data.certificado_url" class="btn btn-success mt-3" target="_blank">
                        📄 Visualizar Certificado
                    </a>
                </div>
            </div>
        </div>
    </div>
    <dmx-serverconnect id="sc_listar_concluidas" url="/api/task/listar_my_tasks_concluida" dmx-param:sort=""></dmx-serverconnect>
    <!-- Wappler include head-page="layouts/dashboard_aluno" fontawesome_5="cdn" bootstrap5="custom" is="dmx-app" id="painel_aluno" appConnect="local" components="{dmxBootstrap5Navigation:{},dmxPreloader:{},dmxAnimateCSS:{},dmxBootstrap5Modal:{},dmxDataTraversal:{}}" -->
    <div class="modal fade" id="modal_certificado_gerado" is="dmx-bs5-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h5 class="modal-title">✅ Certificado Gerado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p>Seu certificado foi gerado com sucesso.

                        {{gerar_certificados_detail.data.id}}</p>
                    <a dmx-bind:href="sc_gerar_certificado.data.certificado_url" class="btn btn-primary mt-3" target="_blank">
                        📄 Ver Certificado
                    </a>
                </div>
            </div>
        </div>
    </div>
    <dmx-preloader id="preloader" bgcolor="#220c49" color="#FFFF" spinner="wanderingCubes"></dmx-preloader>

    <meta name="ac:route" content="/minhas_tarefas">
    <main>
        <div class="main-content">
            <!--breadcrumb-->
            <div class="page-breadcrumb d-none d-sm-flex  mb-3">
                <div class="breadcrumb-title pe-3">Certificados por tarefa</div>
                <div class="ps-3">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 p-0">
                            <li class="breadcrumb-item"><a href="javascript:;"></a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Tarefas</li>
                        </ol>
                    </nav>
                </div>
                <div class="ms-auto">
                </div>
            </div>
            <!--end breadcrumb-->

            <div class="row">
                <div class="col-xl-6 col-xxl-4 d-flex align-items-stretch">
                    <div class="w-100 rounded-4">
                        <a href="https://br.itvalleyschool.com/" target="_blank"></a>
                    </div>
                </div>
                <div class="col-xl-6 col-xxl-4 d-flex align-items-stretch">
                    <div class="w-100 rounded-4">
                        <a href="https://br.itvalleyschool.com/" target="_blank"></a>
                    </div>
                </div>

            </div>

            <div class="col-lg-12 col-xxl-12 d-flex align-items-stretch">
                <div class="card w-100 rounded-4">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="">
                                <h5 class="mb-0">Minhas Tasks concluídas</h5>
                            </div>
                        </div>
                        <div class="order-search position-relative my-3">
                            <input class="form-control rounded-5 px-5" type="text" placeholder="Search">
                            <span class="material-icons-outlined position-absolute ms-3 translate-middle-y start-0 top-50">search</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Tarefas</th>
                                        <th>Estimativa de horas</th>
                                        <th>Dificuldade</th>

                                        <th>Ação</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody is="dmx-repeat" id="repeat_tasks_concluidas" dmx-bind:repeat="sc_listar_concluidas.data.query_listar_my_tasks.data" key="id">
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div>
                                                    <img src="assets/images/top-products/icontasks.png" class="rounded-circle" width="50" height="50">
                                                </div>
                                                <p class="mb-0">{{nome_tarefa}}</p>
                                                <p class="mb-0">{{programa}}</p>
                                            </div>
                                        </td>
                                        <td>{{estimativa_horas_tarefas}} Horas</td>
                                        <td>
                                            <p class="dash-lable mb-0 bg-grd-danger rounded-2 text-white" dmx-class:bg-grd-warning="nivel_tarefas=='Medium'" dmx-class:bg-grd-info="nivel_tarefas=='Easy'">{{nivel_tarefas}}</p>
                                        </td>

                                        <td>
                                            <button class="btn btn-dark text-white" dmx-on:click="gerar_certificados_detail.select(id);flow_certificados.run();modal_certificado_gerado.show()">
                                                Gerar Certificado
                                            </button>
                                        </td>
                                        <td>
                                            <p class="dash-lable mb-0 bg-grd-success rounded-2 text-white" dmx-class:bg-grd-warning="status=='Aprovacao'" dmx-class:bg-grd-success="status=='Concluida'">{{status}}</p>
                                        </td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>


                </div>

            </div>
        </div>

    </main>