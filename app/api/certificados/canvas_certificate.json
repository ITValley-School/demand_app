[
  {
    "name": "identity_user",
    "module": "auth",
    "action": "identify",
    "options": {
      "provider": "security_official"
    },
    "output": true,
    "meta": []
  },
  {
    "name": "tarefas_concluidas",
    "module": "dbupdater",
    "action": "custom",
    "options": {
      "connection": "dbmasterclasse",
      "sql": {
        "query": "SELECT \n  ut.id AS id_usuario_tarefa,\n  t.nome AS nome_tarefa,\n  t.estimativa_horas,\n  u.nome AS nome_aluno,\n  u.programa\nFROM itv.usuarios_tarefas ut\nLEFT JOIN itv.tarefas t ON t.id = ut.tarefa_id\nLEFT JOIN itv.usuarios u ON u.id = ut.usuario_id\nWHERE ut.usuario_id = :identity_user\nAND ut.status = 'Concluida'",
        "params": [
          {
            "name": ":identity_user",
            "value": "{{identity_user}}"
          }
        ]
      }
    },
    "output": true,
    "meta": [
      {
        "name": "id_usuario_tarefa",
        "type": "number"
      },
      {
        "name": "nome_tarefa",
        "type": "text"
      },
      {
        "name": "estimativa_horas",
        "type": "number"
      },
      {
        "name": "nome_aluno",
        "type": "text"
      },
      {
        "name": "programa",
        "type": "text"
      }
    ],
    "type": "dbcustom_query",
    "outputType": "array"
  },
  {
    "name": "",
    "module": "generate_certificate",
    "action": "generate",
    "options": {
      "aluno": "{{tarefas_concluidas.nome_aluno}}",
      "tarefa": "{{tarefas_concluidas.nome_tarefa}}",
      "horas": "{{tarefas_concluidas.estimativa_horas}}",
      "idioma": "{{tarefas_concluidas.programa}}",
      "programa": "{{tarefas_concluidas.programa}}"
    },
    "meta": [
      {
        "name": "path",
        "type": "text"
      }
    ]
  },
  {
    "name": "update_certificate",
    "module": "dbupdater",
    "action": "update",
    "options": {
      "connection": "dbmasterclasse",
      "sql": {
        "type": "update",
        "values": [
          {
            "table": "itv.usuarios_tarefas",
            "column": "certificado_url",
            "type": "text",
            "value": "{{gerar_certificado.path}}",
            "recid": 1
          }
        ],
        "table": "itv.usuarios_tarefas",
        "wheres": {
          "condition": "AND",
          "rules": [
            {
              "id": "tarefa_id",
              "field": "tarefa_id",
              "type": "double",
              "operator": "equal",
              "value": "{{ tarefas_concluidas[0].id_usuario_tarefa }}",
              "data": {
                "column": "tarefa_id"
              },
              "operation": "="
            }
          ],
          "conditional": null,
          "valid": true
        },
        "returning": "id",
        "query": "update [itv].[usuarios_tarefas] set [certificado_url] = @p0 where [tarefa_id] = @p1;select @@rowcount",
        "params": [
          {
            "name": ":P1",
            "type": "expression",
            "value": "{{gerar_certificado.path}}",
            "test": ""
          },
          {
            "operator": "equal",
            "type": "expression",
            "name": ":P2",
            "value": "{{ tarefas_concluidas[0].id_usuario_tarefa }}",
            "test": ""
          }
        ]
      }
    },
    "meta": [
      {
        "name": "affected",
        "type": "number"
      }
    ]
  }
]