        "outputType": "file"
      },
      {
        "type": "text",
        "name": "imagem_url"
      }
    ]
  },
  "exec": {
    "steps": [
      {
        "name": "identity",
        "module": "auth",
        "action": "identify",
        "options": {
          "provider": "security_official"
        },
        "output": true,
        "meta": []
      },
      {
        "name": "upload",
        "module": "upload",
        "action": "upload",
        "options": {
          "path": "/public/assets/images/paises",
          "fields": "{{$_POST.imagem}}",
          "template": "{guid}{ext}"
        },
        "meta": [
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "path",
            "type": "text"
          },
          {
            "name": "url",
            "type": "text"
          },
          {
            "name": "type",
            "type": "text"
          },
          {
            "name": "size",
            "type": "text"
          },
          {
            "name": "error",
            "type": "number"
          }
        ],
        "outputType": "file"
      },
      {
        "name": "insert_country",
        "module": "dbupdater",
        "action": "insert",
        "options": {
          "connection": "dbmasterclasse",
          "sql": {
            "type": "insert",
            "values": [
              {
                "table": "itv.paises",
                "column": "nome",
                "type": "text",
                "value": "{{$_POST.pais}}"
              },
              {
                "table": "itv.paises",
                "column": "imagem_url",
                "type": "text",
                "value": "{{upload.url}}",
                "condition": "{{$_POST.imagem}}"
              }
            ],
            "table": "itv.paises",
            "returning": "id",
            "query": "select top(0) [t].[id] into #out from [itv].[paises] as t left join [itv].[paises] on 0=1;insert into [itv].[paises] ([imagem_url], [nome]) output inserted.[id] into #out values (@p0, @p1); select [id] from #out; drop table #out;",
            "params": [
              {
                "name": ":P1",
                "type": "expression",
                "value": "{{$_POST.pais}}",
                "test": ""
              },
              {
                "name": ":P2",
                "type": "expression",
                "value": "{{upload.url}}",
                "test": ""
              }
            ]
          }
        },
        "meta": [
          {
            "name": "identity",
            "type": "text"
          },
          {
            "name": "affected",
            "type": "number"
          }
        ]
      }
